# ==============================================================================
# SphereSphere — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables for your target environment.
# Never commit real production secrets to version control.

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=spheresphere

# JWT Authentication Secrets (Must be at least 32 cryptographically random chars in production)
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Deployment Environment ('development' or 'production')
ENVIRONMENT=development

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated list of trusted origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie Security (In production, effective_cookie_secure enforces true)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Click Telemetry IP Hashing Salt / Pepper (Must be random in production)
IP_HASH_SALT=replace_with_random_secret

# SlowAPI Rate Limiting (true/false)
RATE_LIMIT_ENABLED=true
