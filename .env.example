# ==============================================================================
# SphereSphere — Environment Configuration Example
# ==============================================================================
# Copy this file to backend/.env and adjust variables for your target environment.
# Never commit real production secrets to version control.

# Backend Configuration (backend/.env)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=spheresphere
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
IP_HASH_SALT=replace_with_random_secret
RATE_LIMIT_ENABLED=true
